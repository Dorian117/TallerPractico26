# Copia este archivo a .env y completa tu clave. NUNCA subas .env al repo.
# En una plataforma (Hugging Face Spaces, etc.) la clave va como "secret",
# no en un archivo.

# Proveedor del LLM del tutor: anthropic (por defecto) | gemini
LLM_PROVIDER=anthropic
# Modelo del tutor (se usa en la app y en run_eval.py)
LLM_MODEL=claude-haiku-5-5
# Modelo juez de Ragas: solo se usa en las corridas finales (--juez-final)
LLM_JUDGE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Privacidad: desactivar la telemetria de las librerias
RAGAS_DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=False

# Proveedor alternativo (solo si LLM_PROVIDER=gemini):
# GEMINI_API_KEY=
